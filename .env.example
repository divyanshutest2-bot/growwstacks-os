# GrowwStacks OS — environment variables
# Copy to .env.local and fill in real values. NEVER commit real secrets.

# Neon connection string using the app_user (non-owner) role.
# RLS is the security boundary; the app must NOT connect as neondb_owner.
DATABASE_URL=

# Auth.js session secret (generate: `openssl rand -base64 32`)
AUTH_SECRET=

# Resend API key for the magic-link Email provider. Sender: login@growwstacks.com
AUTH_RESEND_KEY=

# App base URL (e.g. https://os.growwstacks.com or http://localhost:3000)
AUTH_URL=
