      "800": { "$type": "color", "$value": "#103F72" },
      "900": { "$type": "color", "$value": "#0D335C" }
    },
    "channel": {
      "whatsapp":  { "$type": "color", "$value": "#1F9E62" },
      "slack":     { "$type": "color", "$value": "#7B2D5E" },
      "gmail":     { "$type": "color", "$value": "#D03B2E" },
      "outlook":   { "$type": "color", "$value": "#1860B0" },
      "upwork":    { "$type": "color", "$value": "#14834F" },
      "teams":     { "$type": "color", "$value": "#5832AB" },
      "phone":     { "$type": "color", "$value": "#635E51" },
      "zoom":      { "$type": "color", "$value": "#2176D4" },
      "fireflies": { "$type": "color", "$value": "#C7891C" }
    }
