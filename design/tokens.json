{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "GrowwStacks OS — 'Quiet Signal' design tokens. Source of truth: design/colors_and_type.css (Claude Design). Three layers: primitive -> semantic (light) -> dark overrides. The `tailwindBridge` group at the bottom maps these onto the variable names lib/../tailwind.config.ts already references (--color-bg, --color-surface, --color-text, --color-text-muted, --color-border, --color-primary, --color-success, --color-warning, --color-danger, --space-1..8, --radius-sm/md/lg, --font-family-sans, --font-size-sm/base/lg, --elevation-1/2).",

  "primitive": {
    "$description": "Raw scales. Fixed values. Never used directly in components.",
    "neutral": {
      "50":  { "$type": "color", "$value": "#FAFAF8" },
      "100": { "$type": "color", "$value": "#F2F1EC" },
      "200": { "$type": "color", "$value": "#E7E5DD" },
      "300": { "$type": "color", "$value": "#D5D2C7" },
