      "100": { "$type": "color", "$value": "#D2F2E0" },
      "200": { "$type": "color", "$value": "#A6E5C2" },
      "300": { "$type": "color", "$value": "#6FD19E" },
      "400": { "$type": "color", "$value": "#3DB87C" },
      "500": { "$type": "color", "$value": "#1F9E62" },
      "600": { "$type": "color", "$value": "#14834F" },
      "700": { "$type": "color", "$value": "#0F6740" },
      "800": { "$type": "color", "$value": "#0D5234" },
      "900": { "$type": "color", "$value": "#0A4029" }
