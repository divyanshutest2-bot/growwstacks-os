  "color": {
    "$description": "Semantic — LIGHT (default). Components reference ONLY these. {dark} overrides live in the `dark` group.",
    "bg": {
      "app":            { "$type": "color", "$value": "{primitive.neutral.100}" },
      "surface":        { "$type": "color", "$value": "{primitive.neutral.white}" },
      "surface-raised": { "$type": "color", "$value": "{primitive.neutral.white}" },
      "subtle":         { "$type": "color", "$value": "{primitive.neutral.50}" },
      "sunken":         { "$type": "color", "$value": "{primitive.neutral.100}" },
      "hover":          { "$type": "color", "$value": "{primitive.neutral.100}" },
      "active":         { "$type": "color", "$value": "{primitive.neutral.200}" },
      "overlay":        { "$type": "color", "$value": "rgba(18,16,12,.45)" },
      "sidebar":        { "$type": "color", "$value": "{primitive.neutral.950}" },
      "sidebar-hover":  { "$type": "color", "$value": "rgba(255,255,255,.06)" },
      "sidebar-active": { "$type": "color", "$value": "rgba(123,87,217,.18)" }
    },
    "text": {
      "primary":   { "$type": "color", "$value": "{primitive.neutral.900}" },
      "secondary": { "$type": "color", "$value": "{primitive.neutral.700}" },
      "tertiary":  { "$type": "color", "$value": "{primitive.neutral.500}" },
      "muted":     { "$type": "color", "$value": "{primitive.neutral.400}" },
      "inverse":   { "$type": "color", "$value": "{primitive.neutral.50}" },
      "on-accent": { "$type": "color", "$value": "{primitive.neutral.white}" },
      "link":      { "$type": "color", "$value": "{primitive.iris.600}" }
    },
    "sidebar": {
      "text":        { "$type": "color", "$value": "rgba(250,250,248,.92)" },
      "text-muted":  { "$type": "color", "$value": "rgba(250,250,248,.52)" },
      "text-active": { "$type": "color", "$value": "{primitive.neutral.white}" },
      "heading":     { "$type": "color", "$value": "rgba(250,250,248,.38)" }
    },
    "border": {
      "subtle":  { "$type": "color", "$value": "{primitive.neutral.200}" },
      "default": { "$type": "color", "$value": "{primitive.neutral.300}" },
      "strong":  { "$type": "color", "$value": "{primitive.neutral.400}" },
      "focus":   { "$type": "color", "$value": "{primitive.iris.500}" }
    },
    "accent": {
      "DEFAULT": { "$type": "color", "$value": "{primitive.iris.600}" },
      "hover":   { "$type": "color", "$value": "{primitive.iris.700}" },
      "active":  { "$type": "color", "$value": "{primitive.iris.800}" },
      "subtle":  { "$type": "color", "$value": "{primitive.iris.50}" },
      "border":  { "$type": "color", "$value": "{primitive.iris.200}" },
      "text":    { "$type": "color", "$value": "{primitive.iris.700}" }
    },
    "success": {
      "bg":     { "$type": "color", "$value": "{primitive.green.50}" },
      "border": { "$type": "color", "$value": "{primitive.green.200}" },
      "text":   { "$type": "color", "$value": "{primitive.green.700}" },
      "solid":  { "$type": "color", "$value": "{primitive.green.600}" },
      "fg":     { "$type": "color", "$value": "{primitive.green.500}" }
    },
    "warning": {
      "bg":     { "$type": "color", "$value": "{primitive.amber.50}" },
      "border": { "$type": "color", "$value": "{primitive.amber.200}" },
      "text":   { "$type": "color", "$value": "{primitive.amber.700}" },
      "solid":  { "$type": "color", "$value": "{primitive.amber.500}" },
      "fg":     { "$type": "color", "$value": "{primitive.amber.500}" }
    },
    "danger": {
      "bg":     { "$type": "color", "$value": "{primitive.red.50}" },
      "border": { "$type": "color", "$value": "{primitive.red.200}" },
      "text":   { "$type": "color", "$value": "{primitive.red.700}" },
      "solid":  { "$type": "color", "$value": "{primitive.red.600}" },
      "fg":     { "$type": "color", "$value": "{primitive.red.500}" }
    },
    "info": {
      "bg":     { "$type": "color", "$value": "{primitive.sky.50}" },
      "border": { "$type": "color", "$value": "{primitive.sky.200}" },
      "text":   { "$type": "color", "$value": "{primitive.sky.700}" },
      "solid":  { "$type": "color", "$value": "{primitive.sky.600}" },
      "fg":     { "$type": "color", "$value": "{primitive.sky.500}" }
    },
    "status": {
      "active": { "$type": "color", "$value": "{primitive.green.500}" },
      "away":   { "$type": "color", "$value": "{primitive.amber.400}" },
      "left":   { "$type": "color", "$value": "{primitive.red.500}" }
    },
    "timeline": {
      "ourwork": { "$type": "color", "$value": "{primitive.iris.500}" },
      "waiting": { "$type": "color", "$value": "{primitive.amber.400}" },
      "blocked": { "$type": "color", "$value": "{primitive.red.500}" }
    },
    "ai": {
      "positive": { "$type": "color", "$value": "{primitive.green.600}" },
      "neutral":  { "$type": "color", "$value": "{primitive.sky.600}" },
      "risk":     { "$type": "color", "$value": "{primitive.amber.600}" },
      "tint":     { "$type": "color", "$value": "{primitive.iris.50}" }
    }
  },

  "dark": {
    "$description": "[data-theme=\"dark\"] overrides. Same semantic keys as `color`, re-pointed at deep warm ink. The build step emits these under the [data-theme=\"dark\"] selector.",
    "bg": {
      "app":            { "$type": "color", "$value": "{primitive.neutral.950}" },
      "surface":        { "$type": "color", "$value": "#1A1712" },
      "surface-raised": { "$type": "color", "$value": "#221E18" },
      "subtle":         { "$type": "color", "$value": "#16130F" },
      "sunken":         { "$type": "color", "$value": "{primitive.neutral.black}" },
      "hover":          { "$type": "color", "$value": "rgba(255,255,255,.04)" },
      "active":         { "$type": "color", "$value": "rgba(255,255,255,.08)" },
      "overlay":        { "$type": "color", "$value": "rgba(0,0,0,.62)" },
      "sidebar":        { "$type": "color", "$value": "{primitive.neutral.black}" },
      "sidebar-hover":  { "$type": "color", "$value": "rgba(255,255,255,.06)" },
      "sidebar-active": { "$type": "color", "$value": "rgba(123,87,217,.22)" }
    },
    "text": {
      "primary":   { "$type": "color", "$value": "{primitive.neutral.50}" },
      "secondary": { "$type": "color", "$value": "{primitive.neutral.300}" },
      "tertiary":  { "$type": "color", "$value": "{primitive.neutral.400}" },
      "muted":     { "$type": "color", "$value": "{primitive.neutral.500}" },
      "inverse":   { "$type": "color", "$value": "{primitive.neutral.900}" },
      "on-accent": { "$type": "color", "$value": "{primitive.neutral.white}" },
      "link":      { "$type": "color", "$value": "{primitive.iris.300}" }
    },
    "border": {
      "subtle":  { "$type": "color", "$value": "rgba(255,255,255,.07)" },
      "default": { "$type": "color", "$value": "rgba(255,255,255,.12)" },
      "strong":  { "$type": "color", "$value": "rgba(255,255,255,.20)" },
      "focus":   { "$type": "color", "$value": "{primitive.iris.400}" }
    },
    "accent": {
      "DEFAULT": { "$type": "color", "$value": "{primitive.iris.500}" },
      "hover":   { "$type": "color", "$value": "{primitive.iris.400}" },
      "active":  { "$type": "color", "$value": "{primitive.iris.300}" },
      "subtle":  { "$type": "color", "$value": "rgba(123,87,217,.16)" },
      "border":  { "$type": "color", "$value": "rgba(123,87,217,.34)" },
      "text":    { "$type": "color", "$value": "{primitive.iris.300}" }
    },
    "success": {
      "bg":     { "$type": "color", "$value": "rgba(31,158,98,.14)" },
      "border": { "$type": "color", "$value": "rgba(31,158,98,.34)" },
      "text":   { "$type": "color", "$value": "{primitive.green.300}" },
      "solid":  { "$type": "color", "$value": "{primitive.green.500}" },
      "fg":     { "$type": "color", "$value": "{primitive.green.400}" }
    },
    "warning": {
      "bg":     { "$type": "color", "$value": "rgba(199,137,28,.16)" },
      "border": { "$type": "color", "$value": "rgba(199,137,28,.36)" },
      "text":   { "$type": "color", "$value": "{primitive.amber.300}" },
      "solid":  { "$type": "color", "$value": "{primitive.amber.400}" },
      "fg":     { "$type": "color", "$value": "{primitive.amber.400}" }
    },
    "danger": {
      "bg":     { "$type": "color", "$value": "rgba(208,59,46,.16)" },
      "border": { "$type": "color", "$value": "rgba(208,59,46,.36)" },
      "text":   { "$type": "color", "$value": "{primitive.red.300}" },
      "solid":  { "$type": "color", "$value": "{primitive.red.500}" },
      "fg":     { "$type": "color", "$value": "{primitive.red.400}" }
    },
    "info": {
      "bg":     { "$type": "color", "$value": "rgba(33,118,212,.16)" },
      "border": { "$type": "color", "$value": "rgba(33,118,212,.36)" },
      "text":   { "$type": "color", "$value": "{primitive.sky.300}" },
      "solid":  { "$type": "color", "$value": "{primitive.sky.500}" },
      "fg":     { "$type": "color", "$value": "{primitive.sky.400}" }
    },
    "ai": {
      "positive": { "$type": "color", "$value": "{primitive.green.400}" },
      "neutral":  { "$type": "color", "$value": "{primitive.sky.400}" },
      "risk":     { "$type": "color", "$value": "{primitive.amber.400}" },
      "tint":     { "$type": "color", "$value": "rgba(123,87,217,.14)" }
    },
    "timeline": {
      "ourwork": { "$type": "color", "$value": "{primitive.iris.400}" }
    }
  },

  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Bricolage Grotesque", "Hanken Grotesk", "system-ui", "sans-serif"] },
      "sans":    { "$type": "fontFamily", "$value": ["Hanken Grotesk", "system-ui", "-apple-system", "sans-serif"] },
      "mono":    { "$type": "fontFamily", "$value": ["IBM Plex Mono", "ui-monospace", "SF Mono", "Menlo", "monospace"] }
    },
    "size": {
      "display": { "$type": "dimension", "$value": "40px" },
      "h1":      { "$type": "dimension", "$value": "28px" },
      "h2":      { "$type": "dimension", "$value": "22px" },
      "h3":      { "$type": "dimension", "$value": "17px" },
      "body":    { "$type": "dimension", "$value": "14px" },
      "small":   { "$type": "dimension", "$value": "13px" },
      "xs":      { "$type": "dimension", "$value": "11px" },
      "mono":    { "$type": "dimension", "$value": "13px" }
    },
    "leading": {
      "tight":  { "$type": "number", "$value": 1.12 },
      "snug":   { "$type": "number", "$value": 1.3 },
      "normal": { "$type": "number", "$value": 1.5 }
    },
    "weight": {
      "regular":  { "$type": "number", "$value": 400 },
      "medium":   { "$type": "number", "$value": 500 },
      "semibold": { "$type": "number", "$value": 600 },
      "bold":     { "$type": "number", "$value": 700 },
      "display":  { "$type": "number", "$value": 800 }
    },
    "tracking": {
      "tight":  { "$type": "dimension", "$value": "-0.02em" },
      "snug":   { "$type": "dimension", "$value": "-0.01em" },
      "normal": { "$type": "dimension", "$value": "0" },
      "wide":   { "$type": "dimension", "$value": "0.04em" },
      "label":  { "$type": "dimension", "$value": "0.08em" }
    }
  },

  "space": {
    "0":  { "$type": "dimension", "$value": "0" },
    "1":  { "$type": "dimension", "$value": "4px" },
    "2":  { "$type": "dimension", "$value": "8px" },
    "3":  { "$type": "dimension", "$value": "12px" },
    "4":  { "$type": "dimension", "$value": "16px" },
    "5":  { "$type": "dimension", "$value": "20px" },
    "6":  { "$type": "dimension", "$value": "24px" },
    "8":  { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "20": { "$type": "dimension", "$value": "80px" }
  },

  "radius": {
    "sm":   { "$type": "dimension", "$value": "4px" },
    "md":   { "$type": "dimension", "$value": "8px" },
    "lg":   { "$type": "dimension", "$value": "12px" },
    "xl":   { "$type": "dimension", "$value": "16px" },
    "full": { "$type": "dimension", "$value": "999px" }
  },

  "shadow": {
    "xs": { "$type": "shadow", "$value": "0 1px 2px rgba(18,16,12,.05)" },
    "sm": { "$type": "shadow", "$value": "0 1px 2px rgba(18,16,12,.06), 0 1px 1px rgba(18,16,12,.04)" },
    "md": { "$type": "shadow", "$value": "0 4px 12px -2px rgba(18,16,12,.10), 0 2px 4px -2px rgba(18,16,12,.06)" },
    "lg": { "$type": "shadow", "$value": "0 12px 28px -6px rgba(18,16,12,.16), 0 4px 8px -4px rgba(18,16,12,.08)" },
    "focus":        { "$type": "shadow", "$value": "0 0 0 3px rgba(123,87,217,.28)" },
    "focus-danger": { "$type": "shadow", "$value": "0 0 0 3px rgba(208,59,46,.26)" }
  },

  "motion": {
    "duration": {
      "instant": { "$type": "duration", "$value": "80ms" },
      "fast":    { "$type": "duration", "$value": "130ms" },
      "base":    { "$type": "duration", "$value": "190ms" },
      "slow":    { "$type": "duration", "$value": "280ms" }
    },
    "ease": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
      "out":      { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] },
      "in":       { "$type": "cubicBezier", "$value": [0.5, 0, 0.9, 0.3] },
      "spring":   { "$type": "cubicBezier", "$value": [0.34, 1.4, 0.64, 1] }
    }
  },

  "tailwindBridge": {
    "$description": "COMPATIBILITY ALIASES. These emit the exact CSS variable names tailwind.config.ts already references, so the existing config renders the real Quiet Signal palette with zero config changes. backend-agent's placeholder app/tokens.css should be REPLACED by the compiled output of this file. The names on the left are what Tailwind reads (--color-bg etc.); the values alias the semantic tokens above.",
    "color-bg":          { "$type": "color", "$value": "{color.bg.app}" },
    "color-surface":     { "$type": "color", "$value": "{color.bg.surface}" },
    "color-text":        { "$type": "color", "$value": "{color.text.primary}" },
    "color-text-muted":  { "$type": "color", "$value": "{color.text.tertiary}" },
    "color-border":      { "$type": "color", "$value": "{color.border.default}" },
    "color-primary":     { "$type": "color", "$value": "{color.accent.DEFAULT}" },
    "color-success":     { "$type": "color", "$value": "{color.success.solid}" },
    "color-warning":     { "$type": "color", "$value": "{color.warning.solid}" },
    "color-danger":      { "$type": "color", "$value": "{color.danger.solid}" },
    "font-family-sans":  { "$type": "fontFamily", "$value": "{font.family.sans}" },
    "font-size-sm":      { "$type": "dimension", "$value": "{font.size.small}" },
    "font-size-base":    { "$type": "dimension", "$value": "{font.size.body}" },
    "font-size-lg":      { "$type": "dimension", "$value": "{font.size.h3}" },
    "elevation-1":       { "$type": "shadow", "$value": "{shadow.sm}" },
    "elevation-2":       { "$type": "shadow", "$value": "{shadow.md}" }
  }
}
