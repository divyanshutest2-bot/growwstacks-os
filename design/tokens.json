      "400": { "$type": "color", "$value": "#9576E6" },
      "500": { "$type": "color", "$value": "#7B57D9" },
      "600": { "$type": "color", "$value": "#6A40CC" },
      "700": { "$type": "color", "$value": "#5832AB" },
      "800": { "$type": "color", "$value": "#472A88" },
      "900": { "$type": "color", "$value": "#3A246C" },
      "950": { "$type": "color", "$value": "#241544" }
