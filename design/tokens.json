      "300": { "$type": "color", "$value": "#ECB84A" },
      "400": { "$type": "color", "$value": "#E0A020" },
      "500": { "$type": "color", "$value": "#C7891C" },
      "600": { "$type": "color", "$value": "#A06A14" },
      "700": { "$type": "color", "$value": "#7C5210" },
      "800": { "$type": "color", "$value": "#5E3E0E" },
      "900": { "$type": "color", "$value": "#4A310C" }
