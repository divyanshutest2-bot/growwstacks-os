      "100": { "$type": "color", "$value": "#D0E4FC" },
      "200": { "$type": "color", "$value": "#A5CCF8" },
      "300": { "$type": "color", "$value": "#6FAEF1" },
      "400": { "$type": "color", "$value": "#3E8FE6" },
      "500": { "$type": "color", "$value": "#2176D4" },
      "600": { "$type": "color", "$value": "#1860B0" },
